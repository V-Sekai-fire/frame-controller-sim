{
	"jsonid": "input_profile",
	"controller_type": "oculus_touch",
	"device_class": "TrackedDeviceClass_Controller",
	"resource_root": "vpen",
	"driver_name": "vpen",
	"should_show_binding_errors": true,
	"input_source": {
		"/input/trigger": {
			"type": "trigger",
			"click": true,
			"touch": true,
			"value": true
		},
		"/input/grip": {
			"type": "trigger",
			"value": true,
			"click": true
		},
		"/input/menu": {
			"type": "button",
			"click": true
		},
		"/input/system": {
			"type": "button",
			"click": true
		},
		"/pose/raw": {
			"type": "pose"
		},
		"/output/haptic": {
			"type": "vibration"
		}
	}
}
